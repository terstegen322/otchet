{
  "name": "Отчёт дня",
  "short_name": "Отчёт",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1f6feb",
  "theme_color": "#1f6feb",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "csv",
          "accept": ["text/csv", "text/comma-separated-values", "text/plain", "application/csv", "application/vnd.ms-excel", "application/octet-stream", ".csv", ".CSV"]
        }
      ]
    }
  }
}
